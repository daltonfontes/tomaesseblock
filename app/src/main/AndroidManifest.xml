<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Verifica se o número está nos contatos (para "bloquear desconhecidos" e identificação). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Notificações de chamadas bloqueadas / identificador de chamadas. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Aviso "quem está ligando" desenhado por cima da tela de chamada. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Saber quando a chamada foi atendida/encerrada para fechar o aviso. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".TomaEsseBlockApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TomaEsseBlock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TomaEsseBlock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço que o Android chama ANTES de tocar o telefone, para decidir se bloqueia. -->
        <service
            android:name=".service.CallBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
