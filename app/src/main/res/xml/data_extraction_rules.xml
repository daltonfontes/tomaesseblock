<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: não inclui nenhum dado do app no backup na nuvem nem na transferência
    para um novo aparelho. Lista de bloqueio, denúncias e histórico ficam só neste aparelho.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
